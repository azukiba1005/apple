# -----------------------------------------------------------------
# Apple Price Atlas 環境変数設定
# このファイルをコピーして `.env` を作成し、ご自身の値を設定してください:
#   cp .env.example .env
# ※ 楽天公式API（RAKUTEN_APP_ID）は廃止しました。楽天市場は APIキー不要の公開検索ページ抽出で取得します。
# ※ どの値も未設定で動作します（未設定時は推定相場・元URLのまま安全にフォールバック）
# -----------------------------------------------------------------

# 1. Yahoo!デベロッパーネットワーク (https://e.developer.yahoo.co.jp/)
# Yahoo!ショッピング 商品検索API (v3) 用 Client ID（アプリケーションID）
# ※ 旧名 YAHOO_APP_ID でも読み込めます
YAHOO_CLIENT_ID=

# 2. 楽天市場（APIキー不要）
# 任意: Xserver 等に設置した中継プロキシURL。設定時は `{RAKUTEN_PROXY_URL}?url={楽天検索URL}` 経由で取得
# 未設定時は search.rakuten.co.jp を直接 fetch します
RAKUTEN_PROXY_URL=

# 3. もしもアフィリエイト「どこでもリンク」a_id（楽天市場 / Yahoo!ショッピング / Amazon.co.jp）
# バッチ（GitHub Actions）・Cloudflare Pages Functions 用
# ※ 未設定でもコード内の既定値（楽天市場: 5900939 / Yahoo!: 5900940）で動作します
# ※ Amazon は未提携のため空のまま（空の場合は通常の Amazon 検索URLをそのまま使用）
MOSHIMO_RAKUTEN_AID=5900939
MOSHIMO_YAHOO_AID=5900940
MOSHIMO_AMAZON_AID=
# フロントエンド（Vite）用。未設定時は上の MOSHIMO_* をビルド時に自動で埋め込みます
# ※ VITE_ で始まる値はビルド時に埋め込まれ、ブラウザに公開されます（a_id はリンクに含まれる公開値です）
VITE_MOSHIMO_RAKUTEN_AID=5900939
VITE_MOSHIMO_YAHOO_AID=5900940
VITE_MOSHIMO_AMAZON_AID=

# 4. アクセス解析（任意・Cookie 同意で「分析」が許可された場合のみ読み込まれます）
# Cloudflare Web Analytics のサイトトークン（ダッシュボード > Web Analytics > サイト追加 で発行）
VITE_CF_BEACON_TOKEN=
# Google Analytics 4 の測定ID（例: G-XXXXXXXXXX）
VITE_GA_MEASUREMENT_ID=
