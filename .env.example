# -----------------------------------------------------------------
# 楽天市場 ＆ Yahoo!ショッピング API キー設定
# このファイルをコピーして `.env` を作成し、ご自身の値を設定してください:
#   cp .env.example .env
# ※ 片方のAPIキーのみの設定でも動作します（未設定側は自動フォールバック）
# -----------------------------------------------------------------

# 1. 楽天ウェブサービス (https://webservice.rakuten.co.jp/)
# アプリケーションID
RAKUTEN_APP_ID=
# 任意: アフィリエイトID（設定すると商品リンクがアフィリエイトリンクになります）
RAKUTEN_AFFILIATE_ID=
# 任意: アクセスキー（新OpenAPI仕様で利用する場合）
RAKUTEN_ACCESS_KEY=

# 2. Yahoo!デベロッパーネットワーク (https://e.developer.yahoo.co.jp/)
# Yahoo!ショッピング 商品検索API (v3) 用 Client ID (アプリケーションID)
YAHOO_APP_ID=
# 任意: バリューコマース アフィリエイト (設定するとYahoo!リンクがVC経由になります)
YAHOO_VC_SID=
YAHOO_VC_PID=
# 任意: もしもアフィリエイト (VC未設定時にYahoo!リンクがもしも経由になります)
YAHOO_MOSHIMO_AID=

# 3. アクセス解析（任意・Cookie 同意で「分析」が許可された場合のみ読み込まれます）
# ※ VITE_ で始まる値はビルド時に埋め込まれ、ブラウザに公開されます
# Cloudflare Web Analytics のサイトトークン（ダッシュボード > Web Analytics > サイト追加 で発行）
VITE_CF_BEACON_TOKEN=
# Google Analytics 4 の測定ID（例: G-XXXXXXXXXX）
VITE_GA_MEASUREMENT_ID=
