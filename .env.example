# -----------------------------------------------------------------
# 楽天市場 ＆ Yahoo!ショッピング API キー設定
# このファイルをコピーして `.env` を作成し、ご自身の値を設定してください:
#   cp .env.example .env
# ※ 片方のAPIキーのみの設定でも動作します（未設定側は自動フォールバック）
# -----------------------------------------------------------------

# 1. 楽天ウェブサービス (https://webservice.rakuten.co.jp/)
# アプリケーションID
RAKUTEN_APP_ID=
# 任意: アフィリエイトID（設定すると商品リンクがアフィリエイトリンクになります）
RAKUTEN_AFFILIATE_ID=
# 任意: アクセスキー（新OpenAPI仕様で利用する場合）
RAKUTEN_ACCESS_KEY=

# 2. Yahoo!デベロッパーネットワーク (https://e.developer.yahoo.co.jp/)
# Yahoo!ショッピング 商品検索API (v3) 用 Client ID (アプリケーションID)
YAHOO_APP_ID=
